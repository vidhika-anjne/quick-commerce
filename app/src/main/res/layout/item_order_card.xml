<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Order Header: ID, Date & Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_order_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_black"
                    android:text="#ZEP-94821"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_order_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Today, 12:40 PM"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_order_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_green"
                android:fontFamily="@font/montserrat_medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="⚡ Out for Delivery"
                android:textColor="@color/zepto_green"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ETA Banner -->
        <LinearLayout
            android:id="@+id/layout_eta_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_promo_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/baseline_access_time_24"
                app:tint="@color/zepto_pink" />

            <TextView
                android:id="@+id/tv_order_eta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="⚡ Arriving in 4 mins • Rider: Rajesh K."
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 4-Step Tracking Timeline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Step Circles and Lines -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <!-- Step 1: Placed -->
                <ImageView
                    android:id="@+id/icon_step1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_pill_green"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/zepto_green" />

                <View
                    android:id="@+id/line_step1_2"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@color/zepto_green" />

                <!-- Step 2: Packed -->
                <ImageView
                    android:id="@+id/icon_step2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_pill_green"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/zepto_green" />

                <View
                    android:id="@+id/line_step2_3"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@color/zepto_green" />

                <!-- Step 3: On the Way -->
                <ImageView
                    android:id="@+id/icon_step3"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_pill_pink"
                    android:padding="3dp"
                    android:src="@drawable/ic_delivery_bike"
                    app:tint="@color/zepto_pink" />

                <View
                    android:id="@+id/line_step3_4"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@color/divider" />

                <!-- Step 4: Delivered -->
                <View
                    android:id="@+id/icon_step4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_pill_purple" />

            </LinearLayout>

            <!-- Step Labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_step1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:text="Placed"
                    android:textColor="@color/zepto_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_step2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:text="Packed"
                    android:textColor="@color/zepto_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_step3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:text="On the Way"
                    android:textColor="@color/zepto_pink"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_step4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:text="Delivered"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/divider" />

        <!-- Products List Header -->
        <TextView
            android:id="@+id/tv_items_count_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat_black"
            android:text="Product Details &amp; Tracking"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Container for Product Items with individual tracking status -->
        <LinearLayout
            android:id="@+id/container_order_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Order Footer: Address, Total & Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Order Total"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_order_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_black"
                    android:text="₹244"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_track_rider"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="@font/montserrat_black"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:text="Track Live"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_help"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_add"
                android:fontFamily="@font/montserrat_medium"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="Help"
                android:textAllCaps="false"
                android:textColor="@color/zepto_pink"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

